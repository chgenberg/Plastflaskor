generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLIC
  CUSTOMER
  RESELLER
  AQUA_STAFF
  AQUA_ADMIN
  FACTORY
  LABEL
  BOTTLER
}

enum BuyerType {
  RESELLER
  CUSTOMER
}

enum OrderStatus {
  SUBMITTED
  AQUA_REVIEW
  ARTWORK_AQUA_REVIEW
  ARTWORK_CUSTOMER_APPROVAL
  CONFIRMED
  LABEL_PRODUCTION
  LABELS_DISPATCHED
  LABELS_RECEIVED
  PRODUCTION_SCHEDULED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  READY_TO_INVOICE
  INVOICED
  PAID
}

enum ProductionStatus {
  NOT_PLANNED
  ACCEPTED
  STARTED
  DONE
  ISSUE_FLAGGED
}

enum InvoiceStatus {
  NOT_READY
  READY
  ISSUED
  PARTIALLY_PAID
  PAID
}

enum PriceListCode {
  STANDARD
  SILVER
  GOLD
  SPECIAL
}

enum ProductCategory {
  WATER
  PAPER_CUP
  ENERGY_DRINK
  SPORTS_BOTTLE
  SOFT_DRINK
  COOLER
}

enum ShipmentType {
  GOODS_TO_CUSTOMER
  LABELS_TO_FACTORY
}

enum AddressType {
  BILLING
  SHIPPING
  FACTORY
  HQ
}

enum DesignStatus {
  DRAFT
  SUBMITTED
  ATTACHED_TO_ORDER
}

enum DocumentKind {
  ARTWORK
  PROOF
  PRODUCTION
  ORDER
  LOGISTICS
  FINANCE
  WAYBILL
  OTHER
}

enum RepeatLeadStatus {
  UPCOMING
  ACTIVE
  CUSTOMER_REMINDED
  CONTACTED
  REPEAT_CREATED
  SNOOZED
  NOT_RELEVANT
}

enum ArtworkApprovalKind {
  AQUA_PROOF
  CUSTOMER_FINAL
  AQUA_REJECTED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role
  isActive      Boolean        @default(true)
  companyId     String?
  resellerId    String?
  factoryId     String?
  customerId    String?
  company       Company?       @relation(fields: [companyId], references: [id])
  reseller      Reseller?      @relation(fields: [resellerId], references: [id])
  factory       Factory?       @relation(fields: [factoryId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  notifications Notification[]
  artworkFiles  ArtworkFile[]
}

model Company {
  id        String     @id @default(uuid())
  orgNr     String     @unique
  name      String
  vatNr     String?
  email     String?
  phone     String?
  reseller  Reseller?
  customers Customer[]
  factory   Factory?
  users     User[]
  addresses Address[]
}

model Reseller {
  id          String     @id @default(uuid())
  companyId   String     @unique
  priceListId String
  code        String     @unique
  isActive    Boolean    @default(true)
  company     Company    @relation(fields: [companyId], references: [id])
  priceList   PriceList  @relation(fields: [priceListId], references: [id])
  customers   Customer[]
  orders      Order[]
  users       User[]
  invoices    Invoice[]
}

model Customer {
  id          String               @id @default(uuid())
  resellerId  String?
  companyId   String?
  priceListId String?
  name        String
  orgNr       String?
  email       String?
  phone       String?
  reseller    Reseller?            @relation(fields: [resellerId], references: [id])
  company     Company?             @relation(fields: [companyId], references: [id])
  priceList   PriceList?           @relation(fields: [priceListId], references: [id])
  orders      Order[]
  addresses   Address[]
  users       User[]
  invoices    Invoice[]
  leads       RepeatOpportunity[]
  source      String               @default("staff")
  verifiedAt  DateTime?
  verifiedBy  String?
}

model Address {
  id             String      @id @default(uuid())
  companyId      String?
  customerId     String?
  type           AddressType
  line1          String
  postalCode     String
  city           String
  country        String      @default("SE")
  company        Company?    @relation(fields: [companyId], references: [id])
  customer       Customer?   @relation(fields: [customerId], references: [id])
  factories      Factory[]
  shippingOrders Order[]     @relation("ShippingAddress")
}

model Factory {
  id        String          @id @default(uuid())
  companyId String          @unique
  name      String
  code      String          @unique
  kind      String          @default("bottler")
  isActive  Boolean         @default(true)
  addressId String?
  company   Company         @relation(fields: [companyId], references: [id])
  address   Address?        @relation(fields: [addressId], references: [id])
  users     User[]
  jobs            ProductionJob[]
  orders          Order[]
  labelDispatches LabelDispatch[]
  bottlerInvoices BottlerInvoiceReport[]
}

model Supplier {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique
  kind     String  @default("printer")
  isActive Boolean @default(true)
}

model Product {
  id                String             @id @default(uuid())
  slug              String             @unique
  skuBase           String             @unique
  name              String
  category          ProductCategory
  categorySlug      String
  oneLiner          String
  body              String
  specText          String
  moq               Int
  leadTimeDays      Int                @default(21)
  leadTimeText      String
  country           String
  environmentText   String
  printFormat       String?
  isPublic          Boolean            @default(true)
  studioEnabled     Boolean            @default(true)
  sortOrder         Int                @default(0)
  variants          ProductVariant[]
  printRequirements PrintRequirement[]
}

model ProductVariant {
  id          String          @id @default(uuid())
  productId   String
  sku         String          @unique
  name        String
  volumeMl    Int?
  packSize    Int             @default(1)
  optionsJson String
  isActive    Boolean         @default(true)
  product     Product         @relation(fields: [productId], references: [id])
  prices      PriceListItem[]
  orderItems  OrderItem[]
}

model PrintRequirement {
  id        String  @id @default(uuid())
  productId String
  code      String
  label     String
  required  Boolean @default(true)
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id])
}

model PriceList {
  id        String          @id @default(uuid())
  code      PriceListCode   @unique
  name      String
  currency  String          @default("SEK")
  items     PriceListItem[]
  resellers Reseller[]
  customers Customer[]
}

model PriceListItem {
  id             String         @id @default(uuid())
  priceListId    String
  variantId      String
  unitPriceExVat Float
  minQty         Int            @default(1)
  priceList      PriceList      @relation(fields: [priceListId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId, minQty])
}

model Order {
  id                     String          @id @default(uuid())
  orderNo                String          @unique
  buyerType              BuyerType       @default(RESELLER)
  resellerId             String?
  customerId             String
  currentStatus          OrderStatus
  currency               String          @default("SEK")
  shippingAddressId      String
  factoryId              String?
  source                 String          @default("reseller_order")
  sourceOrderId          String?
  notes                  String?
  requestedDate          String?
  preliminaryDate        String?
  confirmedDate          String?
  deliveryRequirement    String?
  invoiceRef             String?
  extrasJson             String          @default("[]")
  priceSnapshotJson      String?
  visualSpecJson         String?
  cupDocumentJson        String?
  lockedAt               DateTime?
  receivedMailSentAt     DateTime?
  clientToken            String?         @unique
  repeatHorizonMonths    Int?
  factoryDeadline        String?
  factoryDeadlineAccepted Boolean        @default(false)
  factoryIssueNote       String?
  factoryReadyEstimate   String?
  aquaApprovedDelivery   String?
  createdAt              DateTime        @default(now())
  reseller               Reseller?       @relation(fields: [resellerId], references: [id])
  customer               Customer        @relation(fields: [customerId], references: [id])
  shippingAddress        Address         @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  factory                Factory?        @relation(fields: [factoryId], references: [id])
  items                  OrderItem[]
  designs                Design[]
  jobs                   ProductionJob[]
  shipments              Shipment[]
  documents              Document[]
  invoice                Invoice?
  artworkVersions        ArtworkVersion[]
  artworkApprovals       ArtworkApproval[]
  leads                  RepeatOpportunity[]
}

model OrderItem {
  id             String         @id @default(uuid())
  orderId        String
  variantId      String
  qty            Int
  unitPriceExVat Float
  designId       String?
  cupDocumentJson String?
  visualSpecJson String?
  order          Order          @relation(fields: [orderId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
}

model Design {
  id              String         @id @default(uuid())
  orderId         String?
  userId          String?
  productId       String
  variantId       String?
  projectName     String
  source          String
  status          DesignStatus   @default(DRAFT)
  quantity        Int
  optionsJson     String
  canvasJson      String         @default("{}")
  cupDocumentJson String         @default("{}")
  contactJson     String?
  createdAt       DateTime       @default(now())
  order           Order?         @relation(fields: [orderId], references: [id])
  files           ArtworkFile[]
  versions        ArtworkVersion[]
}

model ArtworkFile {
  id           String  @id @default(uuid())
  designId     String
  fileName     String
  mimeType     String
  storageKey   String
  kind         String  @default("original")
  uploadedById String?
  design       Design  @relation(fields: [designId], references: [id])
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
}

model ArtworkVersion {
  id        String   @id @default(uuid())
  orderId   String
  designId  String?
  kind      String   @default("original")
  storageKey String
  title     String
  isFinal   Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  design    Design?  @relation(fields: [designId], references: [id])
}

model ArtworkApproval {
  id        String              @id @default(uuid())
  orderId   String
  kind      ArtworkApprovalKind
  actorRole Role
  note      String?
  createdAt DateTime            @default(now())
  order     Order               @relation(fields: [orderId], references: [id])
}

model ProductionJob {
  id           String           @id @default(uuid())
  orderId      String
  factoryId    String
  status       ProductionStatus @default(NOT_PLANNED)
  plannedAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  operatorNote String?
  order        Order            @relation(fields: [orderId], references: [id])
  factory      Factory          @relation(fields: [factoryId], references: [id])
}

model LabelDispatch {
  id            String               @id @default(uuid())
  reportNo      String               @unique
  factoryId     String
  trackingNo    String
  notes         String               @default("")
  receivedAt    DateTime?
  deviationNote String               @default("")
  createdAt     DateTime             @default(now())
  factory       Factory              @relation(fields: [factoryId], references: [id])
  lines         LabelDispatchLine[]
}

model LabelDispatchLine {
  id         String        @id @default(uuid())
  dispatchId String
  jobId      String
  orderId    String
  qty        Int
  received   Boolean       @default(false)
  dispatch   LabelDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([dispatchId])
}

model BottlerInvoiceReport {
  id        String                 @id @default(uuid())
  reportNo  String                 @unique
  factoryId String
  notes     String                 @default("")
  createdAt DateTime               @default(now())
  factory   Factory                @relation(fields: [factoryId], references: [id])
  lines     BottlerInvoiceLine[]
}

model BottlerInvoiceLine {
  id         String               @id @default(uuid())
  reportId   String
  jobId      String
  orderId    String
  qty        Int
  size       String
  water      String
  cap        String
  trackingNo String               @default("")
  report     BottlerInvoiceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([reportId])
}

model Shipment {
  id          String       @id @default(uuid())
  orderId     String
  type        ShipmentType
  carrier     String
  trackingNo  String?
  waybillNo   String?
  packages    Int          @default(1)
  weightKg    Float        @default(0)
  status      String       @default("CREATED")
  shippedAt   DateTime?
  deliveredAt DateTime?
  order       Order        @relation(fields: [orderId], references: [id])
}

model Document {
  id         String       @id @default(uuid())
  orderId    String?
  entityType String
  entityId   String
  kind       DocumentKind
  title      String
  storageKey String
  version    Int          @default(1)
  createdAt  DateTime     @default(now())
  order      Order?       @relation(fields: [orderId], references: [id])
}

model Invoice {
  id           String        @id @default(uuid())
  orderId      String        @unique
  resellerId   String?
  customerId   String?
  invoiceNo    String        @unique
  fortnoxId    String?
  status       InvoiceStatus @default(NOT_READY)
  amountExVat  Float
  vatAmount    Float
  amountIncVat Float
  issuedAt     DateTime?
  dueAt        DateTime?
  paidAt       DateTime?
  order        Order         @relation(fields: [orderId], references: [id])
  reseller     Reseller?     @relation(fields: [resellerId], references: [id])
  customer     Customer?     @relation(fields: [customerId], references: [id])
}

model RepeatOpportunity {
  id             String           @id @default(uuid())
  sourceOrderId  String
  customerId     String
  status         RepeatLeadStatus @default(UPCOMING)
  expectedAt     DateTime
  activateAt     DateTime
  snoozedUntil   DateTime?
  convertedOrderId String?
  note           String?
  sourceOrder    Order            @relation(fields: [sourceOrderId], references: [id])
  customer       Customer         @relation(fields: [customerId], references: [id])
}

model StatusEvent {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  actorUserId String?
  actorRole   Role
  source      String
  payload     String?
  occurredAt  DateTime @default(now())
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
}

model PageCopy {
  id    String @id @default(uuid())
  slug  String @unique
  title String
  body  String
}

model OrchestratorCard {
  id         String    @id @default(cuid())
  key        String    @unique
  title      String
  body       String    @default("")
  status     String    @default("inbox")
  domainId   String
  playbook   String    @default("")
  gate       String    @default("none")
  filesJson  String    @default("[]")
  source     String    @default("heartbeat")
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, updatedAt])
  @@index([gate, status])
}

model OrchestratorRun {
  id        String    @id @default(cuid())
  kind      String
  status    String
  summary   String    @default("")
  findings  Int       @default(0)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([kind, startedAt])
}
